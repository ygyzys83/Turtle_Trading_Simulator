APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_PAPER=true

# Live trading wiring. Leave these off for paper trading.
# To test live manually later, use the live endpoint, set ALPACA_PAPER=false,
# then intentionally enable both fields below.
ALPACA_LIVE_TRADING_ENABLED=false
ALPACA_LIVE_CONFIRMATION=

# Optional research writer. The app works without an LLM.
# deterministic = built-in plain-English summary
# ollama = local Ollama /api/chat with structured JSON
# gemini = Gemini structured JSON output
RESEARCH_LLM_PROVIDER=deterministic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
RESEARCH_LLM_TIMEOUT_SECONDS=60

